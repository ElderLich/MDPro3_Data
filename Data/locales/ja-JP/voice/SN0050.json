    "V0050_29_00_03_0": {
      "face": 7,
      "frame": 0,
      "cutin": 0,
      "card": [],
      "duelist": [],
      "text": "だったら見せてくれ……\n戦争のない平和な世界を……\nボクに見せてみろよ！"
