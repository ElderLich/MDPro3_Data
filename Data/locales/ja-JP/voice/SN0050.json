    "V0050_28_00_02_0": {
      "face": 3,
      "frame": 0,
      "cutin": 0,
      "card": [],
      "duelist": [],
      "text": "お前の感じた怒りと憎しみこそ\n戦場の全てだ！\nそれがボク達のいた戦場だよ！"
