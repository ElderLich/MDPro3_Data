    "V0906_36_00_02_0": {
      "face": 5,
      "frame": 0,
      "cutin": 0,
      "card": [],
      "duelist": [],
      "text": "ちょっと～　なんとかして～！"
    },
    "V0906_36_00_03_0": {
      "face": 2,
      "frame": 0,
      "cutin": 0,
      "card": [],
      "duelist": [
        903
      ],
