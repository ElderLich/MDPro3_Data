      "text": "이번 턴에서 승리하자!"
    },
    "V9005_01_00_01_0": {
      "face": 1,
      "frame": 0,
      "cutin": 0,
      "card": [],
      "duelist": [],
      "text": "이번 턴에서 승리하는 겁니다!"
    },
    "V9005_01_00_02_0": {
      "face": 1,
      "frame": 0,
      "cutin": 0,
      "card": [],
      "duelist": [],
      "text": "이 문제를 풀 수 있을까나?"
    },
    "V9005_01_00_03_0": {
      "face": 1,
      "frame": 0,
      "cutin": 0,
      "card": [],
      "duelist": [],
      "text": "침착하게 생각해보도록!"
    },
    "V9005_28_00_00_0": {
      "face": 1,
      "frame": 0,
      "cutin": 0,
      "card": [],
      "duelist": [],
      "text": "으음~ 아쉽네요!\n다시 도전하기를 기다릴게!"
    },
    "V9005_28_00_01_0": {
      "face": 1,
      "frame": 0,
      "cutin": 0,
      "card": [],
      "duelist": [],
      "text": "아까워라~\n다시 도전하기를 기다릴게요~"
    },
    "V9005_28_00_02_0": {
      "face": 1,
      "frame": 0,
      "cutin": 0,
      "card": [],
      "duelist": [],
      "text": "이번엔 좀 어려웠었나?\n다음엔 힘내보라구!"
    },
    "V9005_28_00_03_0": {
      "face": 1,
      "frame": 0,
      "cutin": 0,
      "card": [],
      "duelist": [],
      "text": "실패는 성공의 어머니!\n다음엔 힘내보라구!"
    },
    "V9005_29_00_00_0": {
      "face": 2,
      "frame": 0,
      "cutin": 0,
      "card": [],
      "duelist": [],
      "text": "훌륭합니다!"
    },
    "V9005_29_00_01_0": {
      "face": 2,
      "frame": 0,
      "cutin": 0,
      "card": [],
      "duelist": [],
      "text": "예~이!\n역시 소문이 자자한 듀얼리스트!\n잘한다~!"
    },
    "V9005_29_00_02_0": {
      "face": 2,
      "frame": 0,
      "cutin": 0,
      "card": [],
      "duelist": [],
      "text": "이 문제를 풀 줄이야……\n제법이구나!"
    },
    "V9005_29_00_03_0": {
      "face": 2,
      "frame": 0,
      "cutin": 0,
      "card": [],
      "duelist": [],
      "text": "예~이!\n정말 정말 축하드려요~!"
    },
